# ── Anthropic ──────────────────────────────────────────────────────
# API key com permissão de Organization Admin
# console.anthropic.com → Settings → API Keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Telegram ───────────────────────────────────────────────────────
# Token do bot criado no @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCDefghIJKLmnoPQRstuvWXyz1234567890
# ID do canal/chat que recebe alertas (use get_chat_id.py para descobrir)
TELEGRAM_CHAT_ID=-1001234567890

# ── Limites e alertas ──────────────────────────────────────────────
# Limite mensal de tokens (0 = sem limite, alertas de % desativados)
TOKEN_LIMIT=10000000
# Percentuais que disparam alerta (separados por vírgula)
ALERT_THRESHOLDS=50,75,90,95
# Dia do mês em que a fatura reseta
BILLING_DAY=1

# ── Agendamento ────────────────────────────────────────────────────
# Frequência de busca em minutos
FETCH_INTERVAL_MIN=30
# Horário do relatório diário (UTC, formato HH:MM)
DAILY_REPORT_TIME=08:00

# ── Dashboard ──────────────────────────────────────────────────────
PORT=5000
